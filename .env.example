# Mobile app local API configuration.
# Flutter does not read this file automatically. Pass these values at runtime:
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:5000/api --dart-define=WS_BASE_URL=http://10.0.2.2:5000
#
# Use localhost when running Flutter desktop/web on the same machine.
API_BASE_URL=http://10.0.2.2:5000/api
WS_BASE_URL=http://10.0.2.2:5000
